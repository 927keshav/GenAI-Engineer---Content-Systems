# Copy this file to .env and replace the placeholder.
# Never commit .env, and never paste the key into the app.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional. gemini-3.5-flash-lite is a current model for new projects.
# Use gemini-3.8-flash if you want a stronger writer and reviewer.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Relative paths are created inside this project.
SQLITE_PATH=data/lessons.db
